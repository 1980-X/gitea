# Copy to .env and fill secrets. Do not commit .env.
# Stage 1: LAN HTTP via nginx; Git SSH direct to gitea container.

GITEA_HTTP_PORT=18600
GITEA_SSH_PORT=18622
USER_UID=1000
USER_GID=1000

POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gitea

GITEA__server__DOMAIN=192.168.1.84
GITEA__server__ROOT_URL=http://192.168.1.84:18600/
GITEA__server__HTTP_PORT=3000
GITEA__server__DISABLE_SSH=false
GITEA__server__SSH_PORT=18622
