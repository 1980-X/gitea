# Copy to .env and fill secrets. Do not commit .env.
# Stage 1: LAN HTTP via nginx; Git SSH direct to gitea container.

GITEA_HTTP_PORT=18600
GITEA_SSH_PORT=18622
USER_UID=1000
USER_GID=1000

POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gitea

GITEA__server__DOMAIN=192.168.1.84
GITEA__server__ROOT_URL=http://192.168.1.84:18600/
GITEA__server__HTTP_PORT=3000
GITEA__server__DISABLE_SSH=false
GITEA__server__SSH_PORT=18622

# Soft caps (MB). 0 LFS = unlimited. Git SSH push has no Gitea size cap.
# Names must NOT contain "." (compose interpolation breaks). Mapped in docker-compose.yml → GITEA__*.
GITEA_LFS_MAX_FILE_SIZE=0
GITEA_UPLOAD_FILE_MAX_SIZE=102400
GITEA_UPLOAD_MAX_FILES=500
GITEA_ATTACHMENT_MAX_SIZE=102400
GITEA_ATTACHMENT_MAX_FILES=500
GITEA_ATTACHMENT_ALLOWED_TYPES=*/*
GITEA_RELEASE_FILE_MAX_SIZE=102400
GITEA_RELEASE_MAX_FILES=100
GITEA_PACKAGES_LIMIT_TOTAL_OWNER_SIZE=-1
GITEA_PACKAGES_LIMIT_TOTAL_OWNER_COUNT=-1
